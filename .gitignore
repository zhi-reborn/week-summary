.DS_Store
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]
data/
# Local dev runtime data (database, logs) created when overriding
# WRA_DATA_DIR/WRA_LOG_DIR to run the backend inside the repo.
.runtime/
# Defense-in-depth: data/ is already ignored, but explicitly block secret
# files anywhere in the repo in case they are moved out of data/.
**/secrets/
**/model_api_key
**/.env
**/.env.*
!.env.example
build/
dist/
app/static/
app/web/dist/
frontend/dist/
frontend/node_modules/
frontend/test-results/
frontend/vite.config.d.ts
frontend/vite.config.js
*.tsbuildinfo

# Sample weekly report inputs (people's raw .txt reports, merged reports, and
# template .docx) used for manual testing at the repo root. Keep them local.
/*.txt
/*.docx
