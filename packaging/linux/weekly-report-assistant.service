[Unit]
Description=Weekly Report Assistant
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=weekly-report
Group=weekly-report
WorkingDirectory=/opt/weekly-report-assistant
Environment=WRA_HOST=127.0.0.1
Environment=WRA_PORT=8765
Environment=WRA_DATA_DIR=/var/lib/weekly-report-assistant
Environment=WRA_LOG_DIR=/var/log/weekly-report-assistant
EnvironmentFile=-/etc/weekly-report-assistant/environment
ExecStartPre=/opt/weekly-report-assistant/weekly-report-assistant --migrate
ExecStart=/opt/weekly-report-assistant/weekly-report-assistant --run-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/weekly-report-assistant /var/log/weekly-report-assistant

[Install]
WantedBy=multi-user.target
